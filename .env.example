# Config database provider
DB_HOST="localhost"
DB_NAME="robinhoot"
DB_USER="postgres"
DB_PASSWORD="postgres"
DB_PORT="5432"

# Config JWT
JWT_SECRET="YOUR_JWT_SECRET"

# Hosted PostgreSQL: takes precedence over DB_*; always verifies TLS certificates.
# Copy a direct (unpooled) URL into Render's secret environment settings.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full"

# Exact allowed HTTP UI origins. Socket.IO origin integration is tracked in #63.
CORS_ORIGIN="http://localhost:5173"
# Zero locally; one when directly behind Render's ingress proxy.
TRUST_PROXY_HOPS="0"
