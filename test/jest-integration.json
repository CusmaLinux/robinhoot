{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": "\\.spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", {
      "tsconfig": {
        "module": "commonjs",
        "moduleResolution": "node",
        "allowJs": true,
        "resolvePackageJsonExports": false
      }
    }]
  },
  "transformIgnorePatterns": ["/node_modules/(?!(\\.pnpm|kysely)/)"]
}