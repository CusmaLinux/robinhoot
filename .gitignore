# NestJS & TypeScript Outputs
dist/
artifacts/
*.tsbuildinfo

# Dependencies (pnpm specific)
node_modules/
.pnpm-debug.log*

# Environment Variables & Secrets
.env
.env.development
.env.staging
.env.production
.env.local
.env.*.local

# Testing & Coverage
coverage/
.nyc_output/
*.lcov

# IDEs / Editors
# VS Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# JetBrains (WebStorm, IntelliJ, etc.)
.idea/

# Sublime Text / Zed
*.sublime-project
*.sublime-workspace
.zed/

# OS Metadata
.DS_Store
Thumbs.db

# Diagnostic Logs & Lockfiles
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
*.log

# Optional: If you use self-hosted runners or docker targets locally
.dockerignore

# Ignore local CodeGraph indexes
.codegraph/
